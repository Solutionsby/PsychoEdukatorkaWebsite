# Konfiguracja serwera Apache (hosting współdzielony). Wgrywana razem z build/client/.
# Na nginx / innym serwerze ten plik nie działa: te same reguły trzeba ustawić w panelu hostingu.

# Polskie znaki: HTML i tekst w UTF-8 (jak <meta charset> w root.tsx)
AddDefaultCharset UTF-8

# Strona błędu: prerender zapisuje ją jako /404.html
ErrorDocument 404 /404.html

# Każda strona to katalog z index.html (o-mnie/index.html); /o-mnie → /o-mnie/ robi mod_dir
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Jeden adres strony: https i bez www (jak canonical i sitemap.xml)
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://psycho-edukatorka.pl%{REQUEST_URI} [R=301,L]
</IfModule>

# Typy plików (starsze serwery nie znają webp / woff2)
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType image/svg+xml .svg
</IfModule>

# Kompresja tekstu (HTML, CSS, JS, SVG, sitemap)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

# Cache w przeglądarce
<IfModule mod_headers.c>
  # HTML zawsze sprawdzany na serwerze: po wgraniu nowej wersji odwiedzający od razu ją widzą
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # assets/: nazwy plików zawierają skrót treści (np. sky-Dn0PhY_C.webp), więc nowa wersja
  # = nowa nazwa; stare pliki można trzymać w przeglądarce przez rok bez sprawdzania
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>

  # Pliki z public/ bez skrótu w nazwie (favicon, og-image, robots, sitemap): tydzień
  <FilesMatch "\.(png|jpg|txt|xml)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
